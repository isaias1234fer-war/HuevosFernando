generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Calidad {
  id               Int       @id @default(autoincrement())
  nombre           String    @unique
  requiere_limpieza Boolean  @default(false)
  precio_venta_jaba Decimal   @default(0) @db.Decimal(10, 2)
  dias_conservacion_min Int?
  dias_conservacion_max Int?
  compras          Compra[]
  ventas           Venta[]
  detalles_pedido  DetallePedido[]
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nombre           String
  email            String    @unique
  telefono         String?
  direccion        String?
  password         String
  rol              String    @default("cliente") // "admin" | "cliente"
  creado_en        DateTime  @default(now())
  pedidos          Pedido[]
}

model Pedido {
  id                Int             @id @default(autoincrement())
  usuario_id        Int
  usuario           Usuario         @relation(fields: [usuario_id], references: [id])
  fecha_pedido      DateTime        @default(now())
  hora_entrega      DateTime
  direccion_entrega String
  telefono_contacto String?
  notas             String?
  estado            String          @default("pendiente") // "pendiente", "confirmado", "en_camino", "entregado", "cancelado"
  total             Decimal         @db.Decimal(10, 2)
  items             DetallePedido[]
}

model DetallePedido {
  id                Int       @id @default(autoincrement())
  pedido_id         Int
  pedido            Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  calidad_id        Int
  calidad           Calidad   @relation(fields: [calidad_id], references: [id])
  unidad_medida     String    // "jabas", "paquetes", "celdas"
  cantidad_unidades Decimal   @db.Decimal(10, 2)
  cantidad_jabas    Decimal   @db.Decimal(10, 4)
  precio_unitario   Decimal   @db.Decimal(10, 2)
  subtotal          Decimal   @db.Decimal(10, 2)
}

model Compra {
  id              Int       @id @default(autoincrement())
  fecha           DateTime  @default(now())
  fecha_postura   DateTime?
  calidad_id      Int
  calidad         Calidad   @relation(fields: [calidad_id], references: [id])
  cantidad_jabas  Int
  peso_total_kg   Decimal   @db.Decimal(10, 2)
  precio_por_kg   Decimal   @db.Decimal(10, 2)
  costo_total     Decimal   @db.Decimal(10, 2)
  flete_por_jaba  Decimal   @default(0) @db.Decimal(10, 2)
  notas           String?
  limpiezas       Limpieza[]
  ventas          Venta[]
}

model Limpieza {
  id                  Int      @id @default(autoincrement())
  compra_id           Int
  compra              Compra   @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  fecha               DateTime @default(now())
  huevos_rotos        Int
  jabas_rotas_equivalente Decimal @db.Decimal(10, 4)
  observaciones       String?
}

model Venta {
  id              Int       @id @default(autoincrement())
  fecha           DateTime  @default(now())
  calidad_id      Int
  calidad         Calidad   @relation(fields: [calidad_id], references: [id])
  unidad_medida   String    @default("jabas") // jabas, paquetes, celdas, unidades
  cantidad_unidades Decimal @default(1) @db.Decimal(10, 2)
  cantidad_jabas  Decimal   @db.Decimal(10, 4)
  precio_por_jaba Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  notas           String?
  cliente         String?
  tipo_pago       String    @default("contado")
  estado_pago     String    @default("pagado")
  saldo_pendiente Decimal   @default(0) @db.Decimal(10, 2)
  compra_id       Int?
  compra          Compra?   @relation(fields: [compra_id], references: [id])
  pagos           Pago[]
}

model Pago {
  id      Int       @id @default(autoincrement())
  venta_id Int
  venta   Venta     @relation(fields: [venta_id], references: [id])
  fecha   DateTime  @default(now())
  monto   Decimal   @db.Decimal(10, 2)
  notas   String?
}

model Configuracion {
  id             Int   @id @default(autoincrement())
  huevos_por_jaba Int  @default(30)
}
